# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
*.tfvars
*.tfvars.json

# Exception: allow the base terraform.tfvars to be committed (it contains no secrets;
# secrets like SQL passwords are auto-generated by Terraform and stored in Key Vault).
!terraform.tfvars

# Ignore override files as they are usually used only locally
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include override files you do wish to add if missing
# !example_override.tf

# Include tfplan files to prevent accidental commits of plans
*.tfplan*

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Azure CLI / PowerShell local history or caches
*.azure/
.azure/

# OS generated files
.DS_Store
Thumbs.db
